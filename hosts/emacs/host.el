;;; host.el --- irx host: Emacs Lisp regexps  -*- lexical-binding: t -*-
;; Perl-dialect patterns are translated to Emacs syntax: (?: -> \(?:, | -> \|,
;; {m,n} -> \{m,n\}, \d -> [0-9], \s -> [[:space:]], \x{H} -> raw char.
;; Lookarounds have no Emacs equivalent (translation error -> compile error bit).
;; Emacs ^/$ are always line anchors and . never matches \n (s flag emulated).
(require 'json)
(require 'cl-lib)
(defun irx--lit (c)
  (if (memq c '(?. ?* ?+ ?? ?\[ ?^ ?$ ?\\)) (string ?\\ c) (string c)))
(defun irx--class (s i)
  "Translate a [..] class starting at S[I] = ?[. Return (TEXT . NEXT-INDEX)."
  (let ((neg nil) (items '()) (j (1+ i)) (rb nil) (dash nil) (caret nil))
    (when (eq (aref s j) ?^) (setq neg t j (1+ j)))
    (while (not (eq (aref s j) ?\]))
      (let ((c (aref s j)))
        (if (eq c ?\\)
            (let ((d (aref s (1+ j))))
              (cond
               ((eq d ?x) (let* ((e (string-match "}" s j)) (h (substring s (+ j 3) e)))
                            (push (string (string-to-number h 16)) items) (setq j (1+ e))))
               ((eq d ?d) (push "0-9" items) (setq j (+ j 2)))
               ((eq d ?w) (push "[:word:]" items) (setq j (+ j 2)))
               ((eq d ?s) (push "[:space:]" items) (setq j (+ j 2)))
               ((memq d '(?D ?W ?S)) (error "negated escape in class"))
               (t (push (string d) items) (setq j (+ j 2)))))
          (push (string c) items) (setq j (1+ j)))))
    (setq items (nreverse items))
    ;; fix up literal ] - ^ placement (ranges like a-z arrive as "a" "-" "z")
    (let ((out '()) (k 0) (n (length items)))
      (while (< k n)
        (let ((it (nth k items)))
          (cond
           ((and (equal it "-") (> k 0) (< (1+ k) n)) (push "-" out))
           ((equal it "]") (setq rb t))
           ((equal it "-") (setq dash t))
           ((equal it "^") (setq caret t))
           (t (push it out))))
        (setq k (1+ k)))
      (cons (concat "[" (if neg "^" "") (if rb "]" "") (apply #'concat (nreverse out)) (if caret "^" "") (if dash "-" "") "]")
            (1+ j)))))
(defun irx--translate (s dotall)
  (let ((i 0) (n (length s)) (out '()))
    (while (< i n)
      (let ((c (aref s i)))
        (cond
         ((eq c ?\\)
          (let ((d (aref s (1+ i))))
            (cond
             ((eq d ?x) (let* ((e (string-match "}" s i)) (h (substring s (+ i 3) e)))
                          (push (irx--lit (string-to-number h 16)) out) (setq i (1+ e))))
             ((eq d ?d) (push "[0-9]" out) (setq i (+ i 2)))
             ((eq d ?D) (push "[^0-9]" out) (setq i (+ i 2)))
             ((eq d ?s) (push "[[:space:]]" out) (setq i (+ i 2)))
             ((eq d ?S) (push "[^[:space:]]" out) (setq i (+ i 2)))
             ((memq d '(?w ?W ?b ?B)) (push (string ?\\ d) out) (setq i (+ i 2)))
             (t (push (irx--lit d) out) (setq i (+ i 2))))))
         ((eq c ?\[) (let ((r (irx--class s i))) (push (car r) out) (setq i (cdr r))))
         ((eq c ?\()
          (cond
           ((string-prefix-p "(?:" (substring s i)) (push "\\(?:" out) (setq i (+ i 3)))
           ((string-match "\\`(\\?<g[0-9]+>" (substring s i)) (push "\\(" out) (setq i (+ i (match-end 0))))
           ((eq (aref s (1+ i)) ??) (error "lookaround unsupported"))
           (t (push "\\(" out) (setq i (1+ i)))))
         ((eq c ?\)) (push "\\)" out) (setq i (1+ i)))
         ((eq c ?|) (push "\\|" out) (setq i (1+ i)))
         ((eq c ?{) (let ((e (string-match "}" s i))) (push (concat "\\{" (substring s (1+ i) e) "\\}") out) (setq i (1+ e))))
         ((and (eq c ?.) dotall) (push "\\(?:.\\|\n\\)" out) (setq i (1+ i)))
         (t (push (string c) out) (setq i (1+ i))))))
    (apply #'concat (nreverse out))))
(let* ((mode (or (car command-line-args-left) "default"))
       (rep (if (member mode '("repeat" "tierup")) 2 1))
       line)
  (princ (format "ready emacs-%s mode=%s\n" emacs-version mode))
  (while (setq line (ignore-errors (read-from-minibuffer "")))
    (unless (string-empty-p (string-trim line))
      (let* ((clean (replace-regexp-in-string "\\\\u[dD][89abAB][0-9a-fA-F]\\{2\\}" "\\\\uFFFF" line t))
             (msg (json-parse-string clean :array-type 'list))
             (out (format "%s " (car msg))))
        (dolist (c (cadr msg))
          (let ((f (nth 0 c)) (a (nth 1 c)) (r (nth 2 c)) (p (nth 3 c)))
            (setq out
                  (concat out
                          (if (cl-some (lambda (x) (string-search "￿" x)) (list a r p)) "40"
                            (let ((rx (condition-case nil
                                          (concat "\\`\\(?:" (irx--translate p (string-search "s" f)) "\\)\\'")
                                        (error nil))))
                              (if (or (not rx) (condition-case nil (progn (string-match rx "") nil) (invalid-regexp t)))
                                  "04"
                                (let ((case-fold-search (and (string-search "i" f) t)) (bits 0))
                                  (dotimes (k rep)
                                    (when (string-match rx a) (setq bits (logior bits (ash 1 (* 4 k)))))
                                    (when (string-match rx r) (setq bits (logior bits (ash 2 (* 4 k))))))
                                  (format "%02x" bits)))))))))
        (princ (concat out "\n"))))))
